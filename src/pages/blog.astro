---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import PageHeader from '../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { TAGS } from '../data/tags';

const posts = (await getCollection('blog')).sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Collect all unique tags for the filter row
const allTags = [...new Set(posts.flatMap(p => p.data.tags))];
---

<Layout title="Blog">
  <PageHeader current="blog" />

  <!-- Tag filter row (static for Phase 1) -->
  <div class="flex flex-wrap gap-1.5 mb-5">
    {allTags.map(code => {
      const tag = TAGS[code];
      if (!tag) return null;
      return (
        <span style="font-size: 10px; padding: 3px 9px; border-radius: 3px; border: 1px solid var(--color-border); color: var(--color-text);">
          {tag.name}
        </span>
      );
    })}
  </div>

  <!-- Post list -->
  <div class="flex flex-col gap-2.5">
    {posts.map(post => <PostCard post={post} />)}
  </div>
</Layout>
