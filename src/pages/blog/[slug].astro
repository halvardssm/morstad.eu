---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.tsx';
import TagList from '../../components/TagList.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
  }));
}

const { slug } = Astro.params;
const posts = await getCollection('blog');
const post = posts.find(p => p.id === slug);

if (!post) {
  return Astro.redirect('/blog');
}

const { Content } = await render(post);
const { title, date, tags, codeFolderLink } = post.data;
---

<Layout title={title}>
  <PageHeader current="blog" postTitle={title} />

  <!-- Post header -->
  <p class="font-medium m-0 mb-2 text-heading" style="font-size: 20px;">{title}</p>
  <p class="m-0 mb-2.5 text-dim" style="font-size: 12px;">{date}</p>
  <TagList tags={tags} class="mb-3.5" />

  {/* Code folder callout */}
  {codeFolderLink && (
    <div class="flex items-center gap-2 text-muted card" style="padding: 8px 12px; font-size: 12px; margin-bottom: 24px;">
      <Icon name="folder" size={14} color="var(--color-dim)" />
      <span>code_folder:</span>
      <a href={codeFolderLink} target="_blank" rel="noopener" class="text-link">view repository</a>
    </div>
  )}

  <!-- Post content -->
  <div class="prose">
    <Content />
  </div>
</Layout>
