---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PageHeader from '../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { TAGS, TAG_COLORS } from '../data/tags';
import { getGitHubStars } from '../utils/github';

const projects = await getCollection('work');
const featured = projects.filter(p => p.data.featured);
const allProjects = projects.filter(p => !p.data.featured);

// Fetch GitHub stars for projects that have it enabled
const starsMap = new Map<string, number | null>();
await Promise.all(
  projects
    .filter(p => p.data.githubStars && p.data.url)
    .map(async p => {
      const stars = await getGitHubStars(p.data.url!);
      starsMap.set(p.id, stars);
    })
);

// Collect all unique tags from non-featured projects for the filter row
const allTags = [...new Set(allProjects.flatMap(p => p.data.tags))];
---

<Layout title="Work">
  <PageHeader current="work" />

  <!-- Featured -->
  <p class="m-0 mb-2.5 text-dim" style="font-size: 12px;">// featured</p>
  <div class="grid gap-2.5 mb-8" style="grid-template-columns: repeat(3, 1fr); align-items: stretch;">
    {featured.map(project => <ProjectCard project={project} stars={starsMap.get(project.id) ?? null} />)}
  </div>

  <!-- All projects -->
  <div class="pt-5" style="border-top: 1px solid var(--color-border);">
    <p class="m-0 mb-3 text-dim" style="font-size: 12px;">// all projects</p>

    <!-- Tag filter row -->
    <div class="flex flex-wrap gap-1.5 mb-4" id="tag-filters">
      {allTags.map(code => {
        const tag = TAGS[code];
        if (!tag) return null;
        const colors = TAG_COLORS[tag.color];
        return (
          <button
            data-tag={code}
            data-bg={colors.bg}
            data-text={colors.text}
            data-border={colors.border}
            class="work-tag"
            style={`font-size: 10px; padding: 3px 9px; border-radius: 3px; border: 1px solid ${colors.border}; color: ${colors.text}; cursor: pointer; transition: all 0.15s;`}
          >
            {tag.name}
          </button>
        );
      })}
    </div>

    <!-- Masonry layout -->
    <div class="masonry" id="project-list">
      {allProjects.map(project => (
        <div data-tags={project.data.tags.join(',')}>
          <ProjectCard project={project} compact stars={starsMap.get(project.id) ?? null} />
        </div>
      ))}
    </div>
  </div>

  <script>
    const filters = document.querySelectorAll<HTMLButtonElement>('.work-tag');
    const projectItems = document.querySelectorAll<HTMLDivElement>('#project-list > div');
    const selected = new Set<string>();

    function update() {
      filters.forEach(btn => {
        const code = btn.dataset.tag!;
        if (selected.has(code)) {
          btn.style.background = btn.dataset.bg!;
          btn.style.color = btn.dataset.text!;
          btn.style.borderColor = btn.dataset.border!;
        } else {
          btn.style.background = '';
          btn.style.color = btn.dataset.text!;
          btn.style.borderColor = btn.dataset.border!;
        }
      });

      projectItems.forEach(item => {
        const tags = (item.dataset.tags ?? '').split(',').filter(Boolean);
        const visible = selected.size === 0 || [...selected].every(t => tags.includes(t));
        item.style.display = visible ? '' : 'none';
      });
    }

    filters.forEach(btn => {
      btn.addEventListener('click', () => {
        const code = btn.dataset.tag!;
        if (selected.has(code)) {
          selected.delete(code);
        } else {
          selected.add(code);
        }
        update();
      });
    });
  </script>
</Layout>
