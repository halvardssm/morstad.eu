---
import { TAG_COLORS, getTag } from "../utils/tags";

interface Props {
  code: string;
  size?: "sm" | "md";
}

const { code, size = "sm" } = Astro.props;
const tag = getTag(code);
const colors = TAG_COLORS[tag.color];
const padding = size === "sm" ? "2px 7px" : "3px 9px";
---

<span
  style={`font-size: 0.625rem; padding: ${padding}; border-radius: 3px; background: ${colors.bg}; color: ${colors.text}; border: 1px solid ${colors.border}; white-space: nowrap;`}
>
  {tag.name}
</span>
