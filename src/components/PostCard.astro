---
import TagList from './TagList.astro';
import type { Post } from '../data/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<a href={`/blog/${post.slug}`} class="block no-underline">
  <div class="card" style="padding: 1rem 1.1rem; transition: border-color 0.15s;">
    <div class="flex items-start justify-between gap-2.5 mb-1.5">
      <p class="font-medium m-0 text-heading" style="font-size: 14px;">{post.title}</p>
      <p class="m-0 text-dim" style="font-size: 11px; white-space: nowrap;">{post.date}</p>
    </div>
    <p class="m-0 text-muted mb-2" style="font-size: 12px; line-height: 1.6;">{post.summary}</p>
    <TagList tags={post.tags} />
  </div>
</a>
