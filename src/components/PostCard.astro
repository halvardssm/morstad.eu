---
import TagList from './TagList.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, date, tags, summary } = post.data;
---

<a href={`/blog/${post.id}`} class="block no-underline">
  <div class="card" style="padding: 1rem 1.1rem; transition: border-color 0.15s;">
    <div class="flex items-start justify-between gap-2.5 mb-1.5">
      <p class="font-medium m-0 text-heading" style="font-size: 14px;">{title}</p>
      <p class="m-0 text-dim" style="font-size: 11px; white-space: nowrap;">{date}</p>
    </div>
    <p class="m-0 text-muted mb-2" style="font-size: 12px; line-height: 1.6;">{summary}</p>
    <TagList tags={tags} />
  </div>
</a>
