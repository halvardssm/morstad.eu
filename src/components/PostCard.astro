---
import TagList from './TagList.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, date, tags, summary } = post.data;
---

<a href={`/blog/${post.id}`} class="block no-underline">
  <article class="card" style="padding: 1rem 1.1rem; transition: border-color 0.15s;">
    <div class="flex items-start justify-between gap-2.5 mb-1.5">
      <h3 class="font-medium m-0 text-heading" style="font-size: 0.875rem;">{title}</h3>
      <time datetime={date} class="m-0 text-dim" style="font-size: 0.6875rem; white-space: nowrap;">{date}</time>
    </div>
    <p class="m-0 text-muted mb-2" style="font-size: 0.75rem; line-height: 1.6;">{summary}</p>
    <TagList tags={tags} />
  </article>
</a>
