---
import type { Component, FC, ReactNode } from "react";
import Icon, { type IconName } from "./Icon";

interface Props {
  icon: IconName;
  iconColor?: string;
  title: string;
  subtitle: string;
  description: string;
}

const { icon, iconColor, title, subtitle, description } = Astro.props;
---

<div class="card p-4">
  <Icon name={icon} size={16} color={iconColor} />
  <div class="text-heading font-medium mb-1">{title}</div>
  <div class="text-muted text-xs m-0 mb-2">{subtitle}</div>
  <p class="m-0 text-muted text-xs leading-relaxed">{description}</p>
</div>
